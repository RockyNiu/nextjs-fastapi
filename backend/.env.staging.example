# Staging environment configuration
BACKEND_ENV=staging

# Database Configuration (use secrets in actual deployment)
DB_URL=postgresql://user:password@your-staging-db-host:5432/staging_db

# Email Configuration
MAIL_USERNAME=your-staging-email@domain.com
MAIL_PASSWORD=your-staging-app-password
MAIL_FROM=your-staging-email@domain.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
FRONTEND_URL=https://your-staging-frontend.com

# JWT Secret Key (use GitHub secrets in actual deployment)
SECRET_KEY=your-staging-secret-key-here